{
  "name": "figure-cloud-hostless-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Combined Figure Cloud API bridge and Scramjet/Epoxy proxy browser for existing Hostless app",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "check": "node --check server.cjs && node --check ../hostless-cloud.js && node --check ../hostless-proxy/public/proxy.js && node --check ../browser-tutorial.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/epoxy-transport": "^3.0.1",
    "@mercuryworkshop/scramjet": "1.1.0",
    "@mercuryworkshop/wisp-js": "^0.4.1"
  }
}
